# Build outputs
target/

# Runtime data: trajectory JSONL, process snapshots (only .gitkeep is tracked)
var/runs/*
!var/runs/.gitkeep

# Logs — runtime output only. Committed test-fixture logs below are
# source-controlled (a fresh clone must reproduce the fixture tests).
*.log
!src/test/resources/buildlogs/*.log

# Local tooling scratch inside the repo (ctx7 CLI installed workspace-local,
# because the environment does not permit global npm installs — see phase-0 report)
.tools/

# IDE / editor
.idea/
*.iml
.vscode/

# jqwik property-testing working database (regenerated per run)
.jqwik-database

# Python bytecode (protocol checker self-tests)
__pycache__/
