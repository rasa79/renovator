<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.renovator</groupId>
    <artifactId>renovator</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>renovator</name>
    <description>Kotlin + Spring Boot 4 + Embabel agent with dynamic GOAP planning</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Boot 4.1.1 manages kotlin.version = 2.3.21 (verified against spring-boot-dependencies-4.1.1.pom);
             the plan's §3 rule ("Boot-managed kotlin.version first") is satisfied without an explicit property. -->
        <embabel.version>1.5.1</embabel.version>
        <jqwik.version>1.10.1</jqwik.version>
        <ktlint-maven-plugin.version>3.7.1</ktlint-maven-plugin.version>
        <java-diff-utils.version>4.17</java-diff-utils.version>
        <maven-model.version>3.9.16</maven-model.version>
    </properties>

    <dependencies>
        <!-- Kotlin reflection: required for constructor-based @ConfigurationProperties
             binding of Kotlin data classes in Spring Boot -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <!-- Web / REST + SSE (Phase 5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: health, metrics (Micrometer + Prometheus, D14) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Maven Model API + ComparableVersion for Layer 3 (§3 pins; 4.0.0-rc-* excluded) -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model</artifactId>
            <version>${maven-model.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-artifact</artifactId>
            <version>${maven-model.version}</version>
        </dependency>
        <!-- Unified-diff parsing for Layer 2 (L2 applies diffs with a real library,
             never regex — PLAN §7 L2 / LEARN[008]) -->
        <dependency>
            <groupId>io.github.java-diff-utils</groupId>
            <artifactId>java-diff-utils</artifactId>
            <version>${java-diff-utils.version}</version>
        </dependency>
        <!-- YAML for the expected-outcome dataset (D13; ExpectedOutcome, Phase 1/6).
             Jackson 3 (tools.jackson.*) is the Boot 4 primary stack — use it, not the
             coexistence Jackson 2 artifacts some transitive dependencies still carry. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <!-- Embabel agent core (D1, D2) -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter</artifactId>
            <version>${embabel.version}</version>
        </dependency>
        <!-- Cloud LLM provider (OpenAI-compatible, C-8; D5 default = cloud) -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai</artifactId>
            <version>${embabel.version}</version>
        </dependency>
        <!-- Any OpenAI-compatible endpoint (C-8; D5 optional Ollama via LLM_PROVIDER=ollama) -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-starter-openai-custom</artifactId>
            <version>${embabel.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 modularized the MVC test slice: WebMvcTest + the MockMvc
             autoconfigure helpers live in spring-boot-webmvc-test, not in
             spring-boot-test-autoconfigure (which kept only the core slices). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>        <!-- Official Kotlin Mockito matchers: Mockito.any(Class) returns null for
             objects, which trips Kotlin's non-null boundary at the call site; the
             kotlin extension (any<T>()/anyOrNull()) is the supported interop. -->
        <dependency>
            <groupId>org.mockito.kotlin</groupId>
            <artifactId>mockito-kotlin</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>
        <!-- Embabel test support. DRIFT (2026-08-30): the §3 pin
             `embabel-agent-test-support` is published on Central as POM-only
             (aggregator of embabel-agent-test/-common/-internal); depending on it
             as a jar fails resolution. The concrete test-support classes used by
             this project live in `embabel-agent-test` (EmbabelMockitoIntegrationTest)
             and in `embabel-agent-api` (FakePromptRunner, FakeOperationContext,
             IntegrationTestUtils, AgentMetadataReader — transitive via the starter).
             Recorded in docs/verification-log.md, row C-9. -->
        <dependency>
            <groupId>com.embabel.agent</groupId>
            <artifactId>embabel-agent-test</artifactId>
            <version>${embabel.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Property-based tests (jqwik; §3) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                    <jvmTarget>25</jvmTarget>
                </configuration>
                <dependencies>
                    <!-- Standard Kotlin/Spring interop: makes @Configuration/@Component classes open -->
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Lint decision (verified 2026-08-30): ktlint, not detekt (PLAN §3).
                 Bound to verify so an unformatted tree fails the gate command itself. -->
            <plugin>
                <groupId>com.github.gantsign.maven</groupId>
                <artifactId>ktlint-maven-plugin</artifactId>
                <version>${ktlint-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>ktlint-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default (no profile): unit tests only. Class names are matched against the
                         compiled class files, so a Kotlin *IT class is matched by the same patterns.
                         The docker-it / llm-it profiles broaden the include set to run *IT classes. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Docker-dependent *IT tests (sandbox build runner, Phase 1+):
             runs unit tests AND all *IT classes in the same verify. -->
        <profile>
            <id>docker-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- The mock-eval gate (PLAN Task 6.1): `-Peval-mock,docker-it verify` runs
             the eval suite as a hard CI gate (4/4 or the build fails). Declared as
             a marker profile — the eval ITs run with the docker-it includes. -->
        <profile>
            <id>eval-mock</id>
        </profile>
        <!-- The live-eval floor (PLAN Task 6.2): `-Peval-live,docker-it verify` with
             LLM_SMOKE=1 + provider env — never a default build; one live call per
             gated fixture run. -->
        <profile>
            <id>eval-live</id>
        </profile>
        <!-- Live-LLM *IT tests (requires real provider credentials; D13) -->
        <profile>
            <id>llm-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
